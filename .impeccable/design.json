  "narrative": {
    "northStar": "The Illustrated Paperback",
    "overview": "A small illustrated French paperback becomes a browsable digital reading collection. Newsprint surfaces, brass accents and original gouache scenes give the page a material identity, while Switzer keeps navigation and long passages clear.\n\nThe library helps readers choose; Read mode gives prose the space. A clipped book ribbon supplies the recurring motif. Motion belongs to the cover and its illustrations, with a reduced-motion alternative and visible content by default.",
    "keyCharacteristics": [
      "Newsprint and brass with theme-specific ink and paper.",
      "Square editorial surfaces with rounded interactive controls.",
      "Illustrated covers and generous, adjustable reading measure."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Use theme variables together so text and surfaces retain their intended contrast.",
        "section": "colors"
      },
      {
        "name": "The Reading Measure Rule",
        "body": "Keep story prose at a maximum of 65ch with 1.85 line height and zero letter spacing.",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Convey structure through tonal surfaces and spacing, preserving the unshadowed page material.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing theme variables for paper, ink and semantic states.",
      "Do preserve the 65ch reading measure and 1.85 leading.",
      "Do keep native paragraph translations and visible keyboard focus.",
      "Do use original story illustrations as catalogue content."
    ],
    "donts": [
      "Don't introduce resting shadows into the flat paper system.",
      "Don't apply cover entrance motion to reading paragraphs.",
      "Don't turn story covers into generic rounded feature tiles."
    ]
  }
}
